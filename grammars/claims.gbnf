# Section 4.1: one or more claims, each on its own JSON line.
root ::= claim (nl claim)* nl?
claim ::= "{" ws "\"text\":" string "," ws "\"src\":" string "," ws "\"rel\":" rel "," ws "\"dst\":" string ws "}"
rel ::= "\"is_a\"" | "\"defends_against\"" | "\"enables\"" | "\"requires\"" | "\"contradicts\"" | "\"example_of\"" | "\"part_of\""
# JSON escaping and horizontal whitespace preserve one claim per line.
string ::= "\"" ([^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""
ws ::= [ \t]*
nl ::= "\n"
